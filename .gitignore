# Ignore everything by default: setup whitelisting
*
!*/

# Additional folders to ignore
/straight/

### WHITELIST
# Track this file
!.gitignore

# Installation files
!install_macosx.sh
!install_linux.sh

# Base config files
!README.org
!init.el
!herdr.el

# Conductor workspace setup (symlink packages instead of redownloading)
!.conductor/settings.toml
!.conductor/link-emacs-packages.sh

# Dashboard img
!spree.png

# Snippets
!snippets/
!snippets/**/*

# Custom lisp
!lisp/
!lisp/**/*

# Prot-files
!repos/**/*
/repos/scel/
/repos/.DS_Store
/repos/dotfiles/.DS_Store
/repos/dotfiles/emacs/.DS_Store
/repos/dotfiles/emacs/.emacs.d/.DS_Store
/snippets/.DS_Store
